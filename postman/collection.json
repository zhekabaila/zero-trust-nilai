  "item": [
    {
      "name": "Auth (4.1)",
      "item": [
        {
          "name": "login dosen01 (T-AUTH-01)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Device-ID",
                "value": "DEV-DOSEN-01"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"username\":\"dosen01\",\"password\":\"Password123!\"}"
            },
            "url": "{{gw}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const b = pm.response.json();",
                  "pm.collectionVariables.set('access_token', b.access_token);",
                  "pm.collectionVariables.set('refresh_token', b.refresh_token);",
                  "pm.collectionVariables.set('device', 'DEV-DOSEN-01');"
                ]
              }
            }
          ]
        },
        {
          "name": "login password salah (T-AUTH-02)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Device-ID",
                "value": "DEV-DOSEN-01"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"username\":\"dosen01\",\"password\":\"salah\"}"
            },
            "url": "{{gw}}/auth/login"
          }
        },
        {
          "name": "login device asing (T-AUTH-04)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Device-ID",
                "value": "DEV-UNKNOWN-99"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"username\":\"dosen01\",\"password\":\"Password123!\"}"
            },
            "url": "{{gw}}/auth/login"
          }
        },
        {
          "name": "refresh → rotasi (T-AUTH-05/06)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Device-ID",
                "value": "{{device}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"refresh_token\":\"{{refresh_token}}\"}"
            },
            "url": "{{gw}}/auth/refresh"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const b = pm.response.json();",
                  "if (b.access_token) {",
                  "  pm.collectionVariables.set('access_token', b.access_token);",
                  "  pm.collectionVariables.set('refresh_token', b.refresh_token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "logout (T-AUTH-09)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"refresh_token\":\"{{refresh_token}}\"}"
            },
            "url": "{{gw}}/auth/logout"
          }
        },
        {
          "name": "token service (T-SVC-01)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"client_id\":\"service-nilai\",\"client_secret\":\"GANTI_DENGAN_SERVICE_NILAI_CLIENT_SECRET\"}"
            },
            "url": "{{gw}}/auth/service"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('service_token', pm.response.json().access_token || '');"
                ]
              }
            }
          ]
        }
      ]
