            "method": "GET",
            "header": [
              {
                "key": "X-Gateway-Secret",
                "value": "GANTI_DENGAN_GATEWAY_SECRET"
              }
            ],
            "url": "{{service_nilai}}/nilai"
          }
        },
        {
          "name": "GET service-transkrip tanpa secret → 403 (T-GW-02)",
          "request": {
            "method": "GET",
            "url": "{{service_transkrip}}/transkrip/227006001"
          }
        }
      ]
    },
