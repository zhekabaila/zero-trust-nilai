      "value": "http://127.0.0.1:3001"
    },
    {
      "key": "service_transkrip",
      "value": "http://127.0.0.1:3002"
    },
    {
      "key": "device",
      "value": "DEV-DOSEN-01"
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "refresh_token",
      "value": ""
    },
    {
      "key": "service_token",
      "value": ""
