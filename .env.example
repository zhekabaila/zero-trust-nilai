# Salin ke .env — jangan commit .env
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=zerotrust
ZT_GATEWAY_DB_PASSWORD=change-me-gateway
ZT_NILAI_DB_PASSWORD=change-me-nilai
ZT_TRANSKRIP_DB_PASSWORD=change-me-transkrip

# Minimal 32 karakter acak (contoh: openssl rand -hex 32)
GATEWAY_SECRET=change-me-use-openssl-rand-hex-32-xxxxxxxx

# HARUS sama dengan password yang di-hash pada db/init/02-seed.sql
SERVICE_NILAI_CLIENT_SECRET=nilai-service-secret-dev

# Jam akses perubahan/finalisasi nilai (rentang [START, END), zona waktu IANA)
ACCESS_HOURS_START=07:00
ACCESS_HOURS_END=21:00
ACCESS_HOURS_TZ=Asia/Jakarta
